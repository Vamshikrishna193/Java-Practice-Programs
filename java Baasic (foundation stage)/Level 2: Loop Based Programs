1.Print numbers from 1 to 10
sol: class Demo
{
public static void main(String args[])
{
for(int i=1; i<=10;i++)
System.out.println(i);
}
}


2.Print numbers from 10 to 1
sol: class Demo
{
public static void main(String args[])
{
for(int i=10; i>=0; i++)
System.out.println(i);
}
}

3.Print even numbers between 1–50
sol: class Demo
{
public static void  main(String args[])
{
for(int i=1; i<=50;i++)
{
if(i%2==0)
{
System.out.println(i);
}
}
}
}


4.Print odd numbers between 1–50
sol: class Demo
{
public static void main(String args[])
{
for(int i=1; i<=50; i++)
{
if(i%2 ! =0)
{
System.out.println(i)
}
}
}
}

